---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Nekurama — the company behind BABAI"
  description="Nekurama is the parent company behind BABAI, its first product."
>
  <header class="wrap topbar">
    <a class="wordmark" href="#top" aria-label="Nekurama home">NEKURAMA</a>
    <nav aria-label="Main navigation">
      <a href="#company">Company</a>
      <a href="#product">BABAI</a>
    </nav>
  </header>

  <main id="main" class="wrap">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">A company building its first product</p>
        <h1 id="hero-title">NEKURAMA<br />→ BABAI</h1>
        <p class="lede">Nekurama is the parent company behind BABAI, its first product: a business operating platform built around WhatsApp.</p>
        <a class="button" href="#product">Meet BABAI <span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit"></div><span class="signal one"></span><span class="signal two"></span>
        <div class="orbit-label"><strong>One company.<br />One product first.</strong><span>NEKURAMA is the parent.<br />BABAI is the first product.</span></div>
      </div>
    </section>

    <section class="section" id="company" aria-labelledby="company-title">
      <div class="section-heading">
        <p class="eyebrow">The company</p>
        <div>
          <h2 id="company-title">One company. One product first.</h2>
          <p>Nekurama is the parent company behind BABAI. BABAI is its first product.</p>
        </div>
      </div>
      <article class="product-card" id="product">
        <div>
          <p class="eyebrow">First product</p>
          <h3>BABAI</h3>
          <p>A business operating platform built around WhatsApp. The product is being shaped around customer conversations and the work that follows them.</p>
          <p class="product-link"><a class="text-link" href="https://babai.nekurama.com/">Explore the BABAI product page <span aria-hidden="true">↗</span></a></p>
        </div>
        <div class="product-mark" aria-hidden="true">B.</div>
      </article>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner"><span>NEKURAMA — parent company</span><span>First product: <a class="text-link" href="https://babai.nekurama.com/">BABAI</a></span></div>
  </footer>
</SiteLayout>
