---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Nekurama — ideas in motion"
  description="Nekurama explores ideas and inspiration, and the products they can become."
>
  <header class="wrap topbar">
    <a class="wordmark" href="#top" aria-label="Nekurama home">NEKURAMA</a>
    <nav aria-label="Main navigation">
      <a href="#company">Company</a>
      <a href="/products/">Products</a>
    </nav>
  </header>

  <main id="main" class="wrap">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">Ideas, explored with intention</p>
        <h1 id="hero-title">A vision in motion.</h1>
        <p class="lede">Nekurama is a company shaped by curiosity: exploring ideas, following inspiration, and creating products from what feels worth pursuing.</p>
        <a class="button" href="/products/">Explore our products <span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit"></div><span class="signal one"></span><span class="signal two"></span>
        <div class="orbit-label"><strong>Ideas move.<br />Possibilities open.</strong><span>Exploration becomes inspiration.<br />Inspiration can become something useful.</span></div>
      </div>
    </section>

    <section class="section" id="company" aria-labelledby="company-title">
      <div class="section-heading">
        <p class="eyebrow">What moves us</p>
        <div>
          <h2 id="company-title">Curiosity gives ideas room to grow.</h2>
          <p>We follow questions, notice possibilities, and explore what could make a meaningful difference. Some ideas become products. Each one starts with looking closer.</p>
        </div>
      </div>
      <p><a class="text-link" href="/products/">Explore our products <span aria-hidden="true">↗</span></a></p>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-inner"><span>NEKURAMA</span><a class="text-link" href="/products/">Explore our products</a></div>
  </footer>
</SiteLayout>
